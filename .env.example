# Copy this file to .env and paste each key right after the "=" (no quotes, no spaces).
# .env is ignored by git and loaded automatically.

# ---- Required for the default setup ----

# LLM summaries. Get a key at https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=

# Text-to-speech. Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram channel to post to: an id like -1001234567890, or @channel_name
TELEGRAM_TEST_CHANNEL=

# ---- Optional: only if you switch a podcast YAML to one of these providers ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
